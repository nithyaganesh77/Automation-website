{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automation-website",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://automation-website-pyp9.onrender.com"
  },
  "assets": {
    "directory": "./frontend/.next",
    "binding": "ASSETS"
  }
}

