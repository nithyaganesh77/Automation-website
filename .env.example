# ==============================================================================
# DOCUMIND AI — ZERO-BUDGET FREE-FIRST ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security & Authentication
JWT_SECRET_KEY=documind_ai_super_secret_jwt_key_enterprise_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL in Docker / SQLite for Local Zero-Dependency Dev)
DATABASE_URL=sqlite:///./documind.db
# PostgreSQL (Docker Compose):
# DATABASE_URL=postgresql://documind:documind_secure_password_2026@localhost:5432/documind_db

# Background Task Processing & Cache (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Qdrant Open-Source Vector Database (Local Free Tier)
QDRANT_URL=http://localhost:6333

# MinIO Local S3-Compatible Object Storage (No AWS S3 Required)
STORAGE_TYPE=local
UPLOAD_DIR=storage/uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documind-documents
MINIO_SECURE=false
MAX_FILE_SIZE_BYTES=26214400

# ------------------------------------------------------------------------------
# FREE-FIRST AI PROVIDERS (GOOGLE GEMINI & GROQ)
# ------------------------------------------------------------------------------
# Primary: Google Gemini API (Free tier)
# Secondary / Fallback: Groq API (Ultra-fast open models free tier)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.8-27b

# Add your free API keys manually here or via the Settings UI:
GEMINI_API_KEY=
GROQ_API_KEY=

# Document Privacy & Quota Protection
# Set to 'true' to disable all external AI calls and run 100% locally
DISABLE_EXTERNAL_AI=false

# Free Tier Safety Limits (Prevents unexpected rate limits or lockouts)
DAILY_REQUEST_LIMIT=1500
MONTHLY_TOKEN_BUDGET=1000000
SAFE_QUOTA_MODE=true

# Business & Accounting Rules
CONFIDENCE_THRESHOLD=0.85
AUTO_APPROVE_THRESHOLD=0.98
TAX_TOLERANCE_AMOUNT=2.0
DEFAULT_CURRENCY=INR

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
