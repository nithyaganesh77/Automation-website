# ==============================================================================
# DOCUMIND AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security & Authentication
# Generate using: openssl rand -hex 32
SECRET_KEY=documind_ai_super_secret_jwt_key_enterprise_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./documind.db
# PostgreSQL Production:
# DATABASE_URL=postgresql://documind:documind_secure_password_2026@localhost:5432/documind_db

# Background Task Processing & Cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_BYTES=26214400

# AI Provider Configuration (Gemini API / OpenAI API)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o

# External Provider API Keys (Leave blank to use deterministic offline fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Financial Compliance Defaults
CONFIDENCE_THRESHOLD=0.85
AUTO_APPROVE_THRESHOLD=0.98
TAX_TOLERANCE_AMOUNT=2.0
DEFAULT_CURRENCY=INR

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
